<Window x:Class="DeepSeekStatus.Views.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:DeepSeekStatus.Views"
        Width="427"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="15.3"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.7" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SwitchToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="25" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track" CornerRadius="12.5"
                                    Background="{DynamicResource ControlTrack}"
                                    BorderBrush="{DynamicResource PanelBorder}"
                                    BorderThickness="1" />
                            <Ellipse x:Name="Thumb" Width="19" Height="19" Fill="White"
                                     HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.35" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentSwitch}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="Transparent" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Segment" CornerRadius="6" Background="Transparent" Padding="0,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="{DynamicResource SegmentSelected}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="{DynamicResource SegmentHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="16" BorderThickness="1"
            Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource PanelBorder}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.4" Color="Black" />
        </Border.Effect>
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel>
                <Grid Height="179">
                    <v:AquariumControl x:Name="Aquarium" />
                    <TextBlock x:Name="ClockLabel"
                               HorizontalAlignment="Right" VerticalAlignment="Top"
                               Margin="0,16,16,0" FontSize="13.3"
                               Foreground="#8CFFFFFF" />
                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Margin="16,0,0,16" CornerRadius="12"
                            Background="#40000000" BorderBrush="#24FFFFFF" BorderThickness="1"
                            Padding="15,7">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="BadgeDot" Width="9" Height="9" VerticalAlignment="Center" />
                            <TextBlock x:Name="BadgePeriod" Margin="9,0,0,0" FontSize="16.7"
                                       FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                            <TextBlock x:Name="BadgeTime" Margin="8,0,0,0" FontSize="16.7"
                                       Foreground="#B3FFFFFF" VerticalAlignment="Center"
                                       Typography.NumeralAlignment="Tabular" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="PreviewBanner" Visibility="Collapsed" Padding="21,8">
                    <DockPanel>
                        <TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,7,0" Foreground="{DynamicResource TextPrimary}" />
                        <Button x:Name="PreviewResume" DockPanel.Dock="Right"
                                Style="{StaticResource LinkButton}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock x:Name="PreviewBannerText" FontSize="14" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimary}" />
                    </DockPanel>
                </Border>

                <StackPanel x:Name="ContentStack" Margin="20,14,20,20" Grid.IsSharedSizeScope="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PeriodTitle" FontSize="25.3" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="Multiplier" Grid.Column="1" FontSize="20" FontWeight="Bold"
                                   Margin="10,0,0,2" VerticalAlignment="Bottom" />
                    </Grid>
                    <TextBlock x:Name="PeriodSummary" Margin="0,5,0,0" FontSize="15.3"
                               Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />

                    <Grid Margin="0,14,0,0">
                        <TextBlock x:Name="CurrentRateLabel" FontSize="15.3" FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                        <TextBlock x:Name="RateText" HorizontalAlignment="Right" FontSize="15.3"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>
                    <v:RatioBar x:Name="RateBar" Height="8" Margin="0,8,0,0" />

                    <Grid Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="14.7"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                            <TextBlock x:Name="CountdownTitle" Margin="7,0,0,0" FontSize="15.3"
                                       FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="CountdownValue" HorizontalAlignment="Right" FontSize="16.7"
                                   FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                    </Grid>
                    <TextBlock x:Name="CountdownDetail" Margin="0,5,0,0" FontSize="14"
                               Foreground="{DynamicResource TextSecondary}" />
                    <v:RatioBar x:Name="IntervalBar" Height="4" Margin="0,8,0,0" />

                    <Rectangle Height="1" Fill="{DynamicResource Separator}" Margin="0,14,0,0" />

                    <TextBlock x:Name="ScheduleTitleLabel" Margin="0,14,0,0" FontSize="14.7"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />

                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="RuleLabel" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="12" Height="12" CornerRadius="3" Background="#FF4D6BFE"
                                VerticalAlignment="Top" Margin="0,3,0,0" />
                        <TextBlock x:Name="PeakRuleLabel" Grid.Column="1" Margin="9,0,0,0" FontSize="14.7"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock x:Name="PeakRuleDetail" Grid.Column="2" Margin="8,0,0,0" FontSize="14.7"
                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="RuleLabel" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="OffPeakSwatch" Width="12" Height="12" CornerRadius="3"
                                Background="#2E6E6E73" VerticalAlignment="Top" Margin="0,3,0,0" />
                        <TextBlock x:Name="OffPeakRuleLabel" Grid.Column="1" Margin="9,0,0,0" FontSize="14.7"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock x:Name="OffPeakRuleDetail" Grid.Column="2" Margin="8,0,0,0" FontSize="14.7"
                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                    </Grid>

                    <v:WeekScheduleGrid x:Name="WeekGrid" Height="94" Margin="0,10,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Border Width="12" Height="12" CornerRadius="3" Background="#FF4D6BFE" VerticalAlignment="Center" />
                        <TextBlock x:Name="LegendPeak" Margin="7,0,0,0" FontSize="13.3"
                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                        <Border x:Name="OffPeakLegendSwatch" Width="12" Height="12" CornerRadius="3"
                                Background="#2E6E6E73" Margin="20,0,0,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="LegendOffPeak" Margin="7,0,0,0" FontSize="13.3"
                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="Footnote" Margin="0,7,0,0" FontSize="12.7"
                               Foreground="{DynamicResource TextTertiary}" TextWrapping="Wrap" />

                    <Rectangle Height="1" Fill="{DynamicResource Separator}" Margin="0,14,0,0" />

                    <Grid Margin="0,14,0,0">
                        <TextBlock x:Name="CountdownOptionLabel" FontSize="15.3"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                        <ToggleButton x:Name="CountdownToggle" Style="{StaticResource SwitchToggle}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,11,0,0">
                        <TextBlock x:Name="LaunchOptionLabel" FontSize="15.3"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                        <ToggleButton x:Name="LaunchToggle" Style="{StaticResource SwitchToggle}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="LaunchMessage" Margin="0,6,0,0" FontSize="12.7"
                               Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                               Visibility="Collapsed" />
                    <Grid Margin="0,11,0,0">
                        <TextBlock x:Name="PreviewLabel" FontSize="15.3"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                        <Border HorizontalAlignment="Right" CornerRadius="8"
                                Background="{DynamicResource ControlTrack}" Padding="2">
                            <UniformGrid Columns="3" Width="248">
                                <RadioButton x:Name="SegmentAuto" Style="{StaticResource SegmentRadio}"
                                             GroupName="Preview" FontSize="14" />
                                <RadioButton x:Name="SegmentPeak" Style="{StaticResource SegmentRadio}"
                                             GroupName="Preview" FontSize="14" />
                                <RadioButton x:Name="SegmentOffPeak" Style="{StaticResource SegmentRadio}"
                                             GroupName="Preview" FontSize="14" />
                            </UniformGrid>
                        </Border>
                    </Grid>

                    <Grid Margin="0,17,0,0">
                        <TextBlock x:Name="VersionText" FontSize="12.7"
                                   Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center" />
                        <Button x:Name="QuitButton" Style="{StaticResource LinkButton}"
                                HorizontalAlignment="Right" FontSize="14.7" FontWeight="Medium" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
